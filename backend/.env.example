PORT=4000
DATABASE_URL="postgresql://stocksense:stocksense@localhost:5442/stocksense?schema=public"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Password-reset emails. Leave SMTP_HOST empty to skip real email (OTP is logged / returned as devOtp in dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="StockSense <no-reply@example.com>"

# Set to 1 when running behind a reverse proxy so rate limiting uses the real client IP.
# TRUST_PROXY=1
